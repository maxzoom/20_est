# 복사하여 .env에 SMTP 정보를 입력하세요.
# 기본 동작은 .eml 미리보기입니다. 실제 발송 버튼을 누르면 SMTP를 사용합니다.
MAIL_MODE=preview

SMTP_HOST=mail.ezgeo.com
# STARTTLS: 587 / 처음부터 TLS 연결: 465
SMTP_PORT=587
# 587: false / 465: true
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true

SMTP_USER=
SMTP_PASS=

# 비어 있으면 이메일 형식인 SMTP_USER를 발신 주소로 사용합니다.
MAIL_FROM=
MAIL_FROM_NAME="견적 관리"
